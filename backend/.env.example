DATABASE_URL=postgresql+psycopg://paytmflow:paytmflow@localhost:5432/paytmflow
APP_ENV=local
SESSION_COOKIE_NAME=pf_session
SESSION_SECRET=change-me-32-bytes-minimum-session-secret-key
SESSION_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
AI_PROVIDER=mock
# mock  = deterministic fixed-output MockAI (tests/CI/default dev)
# llm   = real hosted OpenAI-compatible LLM (requires AI_API_KEY)
# local_ml = real local document intelligence (app/docai) - OCR + trained
#            classifier/extractor, no external API. Currently trained for
#            LENDING only; see backend/docs/docai_report.md.
# sarvam = real Sarvam AI Document AI/speech/translate/chat (requires
#          SARVAM_API_KEY), falls back to local_ml on any Sarvam failure.
AI_TIMEOUT_SECONDS=4
AI_API_KEY=
AI_MODEL=
# OpenAI-compatible base URL for the LLM chat client. Empty = the default,
# https://api.openai.com/v1. Point it at a local inference server (e.g. Ollama's
# http://localhost:11434/v1) to run a model with no API key; when set, the API
# also preloads that model in the background at startup.
AI_BASE_URL=
# Sarvam AI (https://docs.sarvam.ai) - backend-only key, never sent to the frontend.
SARVAM_ENABLED=false
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_DOCUMENT_ENABLED=true
SARVAM_SPEECH_ENABLED=true
SARVAM_TRANSLATION_ENABLED=true
SARVAM_CHAT_ENABLED=true
SARVAM_TIMEOUT_SECONDS=25
SARVAM_POLL_INTERVAL_SECONDS=1.5
SARVAM_MAX_POLL_ATTEMPTS=12
SARVAM_STT_MODEL=saaras:v3
# n8n Cloud outbound notifications (Review Center lifecycle -> Slack/email).
# Backend-only secret. Use the PRODUCTION webhook, never .../webhook-test/...
N8N_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Must match the header name configured on the n8n webhook's Header Auth credential.
N8N_WEBHOOK_HEADER_NAME=X-Webhook-Secret
N8N_TIMEOUT_SECONDS=5
# Events go to the n8n_outbox table in the same commit as the change that emits
# them, then are sent after the commit. HTTP tries per send (exponential backoff
# from the base below, or the server's Retry-After on 429/503):
N8N_MAX_ATTEMPTS=3
N8N_RETRY_BACKOFF_SECONDS=0.5
# Total seconds one request may spend delivering its events after commit;
# anything not delivered stays PENDING for the background sweeper.
N8N_FLUSH_BUDGET_SECONDS=8
# Background sweep interval in seconds (0 disables it; then run
# python -m app.integrations.n8n_redeliver yourself), the claim lease (must
# exceed N8N_FLUSH_BUDGET_SECONDS + N8N_TIMEOUT_SECONDS), the HTTP tries across
# all sends before an event is marked PERMANENT, and the Retry-After ceiling.
N8N_OUTBOX_SWEEP_SECONDS=30
N8N_OUTBOX_LEASE_SECONDS=60
N8N_OUTBOX_MAX_ATTEMPTS=30
N8N_RETRY_AFTER_MAX_SECONDS=3600
# Days n8n_outbox rows are kept. This is an engineering retention control. The
# production value must be selected and approved by the application/data owner
# according to applicable retention requirements. No default: required when
# N8N_ENABLED=true outside local/ci (the app refuses to start without it);
# unset in local/ci means no cleanup.
# N8N_FAILURE_RETENTION_DAYS=
EVIDENCE_STORAGE_DIR=./storage/evidence
EVIDENCE_MAX_BYTES=10485760
# Whether EVIDENCE actions may be applied without an uploaded evidence_id (the
# client-supplied input is then trusted; meant for test fixtures). Leave unset:
# unset = allowed only when APP_ENV is local/ci, refused everywhere else.
# true/false overrides that in any environment.
# ALLOW_EVIDENCE_ACTIONS_WITHOUT_EVIDENCE=
DEMO_RESET_SECRET=change-me-demo-reset-secret
# Required outside local/ci to enter the Review Center; leave empty to disable reviewer promotion there.
# Use at least 16 random characters; a startup warning is logged (never the value) if weaker.
REVIEWER_ACCESS_CODE=
# Per-minute limits on /chat, /journeys/{id}/chat(/voice) and /translate (429 + Retry-After).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_TRANSLATE_PER_MINUTE=30
RATE_LIMIT_IP_PER_MINUTE=120
# One ceiling for all callers of an instance; bounds paid-API spend even if IPs are spoofed.
RATE_LIMIT_GLOBAL_PER_MINUTE=600
# Proxies that append to X-Forwarded-For in front of the API. 0 = key on the TCP peer.
# The per-IP limit only applies to public addresses: behind a proxy with 0 hops the
# peer is the proxy, so only the session and global limits apply.
# Only raise it after confirming the header chain your platform actually sends.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
# Attempts at POST /review/role (reviewer access code) per minute.
RATE_LIMIT_REVIEWER_ROLE_PER_MINUTE=5
RATE_LIMIT_REVIEWER_ROLE_IP_PER_MINUTE=20
RATE_LIMIT_REVIEWER_ROLE_GLOBAL_PER_MINUTE=60
LOG_LEVEL=INFO
# Deployed commit shown by /health. Leave unset on Render: RENDER_GIT_COMMIT is used.
# Without metadata /health says "dev" in local/ci and "unknown" anywhere else.
# GIT_SHA=
