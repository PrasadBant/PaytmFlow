# --- Frontend (Node / Vite) ---
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/coverage/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/.env.local

# --- Backend (Python / FastAPI) ---
backend/.venv/
backend/.venv-ocr-bench/
backend/__pycache__/
**/__pycache__/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.import_linter_cache/
backend/*.egg-info/
backend/storage/evidence/*
!backend/storage/evidence/.gitkeep
backend/.env

# --- Agent / tooling scratch (not part of the product) ---
.agents/
.planning/
graphify-out/

# --- OS / editor ---
.DS_Store
Thumbs.db
nul
.vscode/
.idea/

# --- Document AI dataset (regenerable, large binary files) ---
# Regenerate with: uv run python -m app.docai.dataset.generate
#                   uv run python -m app.docai.dataset.build_ocr_cache
# labels.jsonl / ocr_cache.jsonl / reports / dataset_manifest.json are
# small and ARE committed (evidence + reproducibility); only the bulk
# generated PDF/JPG documents themselves are excluded.
backend/data/docai/**/*.pdf
backend/data/docai/**/*.jpg
backend/data/docai/**/*.jpeg
backend/data/docai/**/*.png
